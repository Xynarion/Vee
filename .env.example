# Copy to .env and replace the placeholders.
# Postgres (Docker Compose service: db)
POSTGRES_DB=progress_memory
POSTGRES_USER=pm_app
POSTGRES_PASSWORD=change_me_to_a_secret
POSTGRES_PORT=5432

# App on the host (pytest / alembic against published port)
DATABASE_URL=postgresql+psycopg://pm_app:change_me_to_a_secret@127.0.0.1:5432/progress_memory

# When a container talks to Compose `db`, use host `db` instead of 127.0.0.1
# (docker compose --profile migrate run --rm migrate sets this automatically)

# Telegram + FastAPI (M2)
TELEGRAM_BOT_TOKEN=123456:replace_with_bot_token_from_botfather
WEBHOOK_URL=https://your-subdomain.ngrok-free.app
TELEGRAM_WEBHOOK_SECRET=replace_with_long_random_string
APP_HOST=0.0.0.0
APP_PORT=8000

# Inspector V0 (/inspector?token=...). Your Telegram chat id, and a long random token.
INSPECTOR_TELEGRAM_ID=123456789
INSPECTOR_TOKEN=replace_with_long_random_string

# Vee Decision Lab (Together). Leave the key empty to force mock inference.
TOGETHER_API_KEY=
TOGETHER_MODEL=Qwen/Qwen3.5-9B
LAB_DB_PATH=lab/data/lab.sqlite3
