# Copy to .env and replace the placeholders.
# Postgres (Docker Compose service: db)
POSTGRES_DB=progress_memory
POSTGRES_USER=pm_app
POSTGRES_PASSWORD=change_me_to_a_secret
POSTGRES_PORT=5432

# App on the host (pytest / alembic against published port)
DATABASE_URL=postgresql+psycopg://pm_app:change_me_to_a_secret@127.0.0.1:5432/progress_memory

# When a container talks to Compose `db`, use host `db` instead of 127.0.0.1
# (docker compose --profile migrate run --rm migrate sets this automatically)
